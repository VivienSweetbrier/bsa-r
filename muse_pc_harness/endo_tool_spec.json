  "native_tools": {
    "environment.describe": {
      "category": "environment",
      "windows_port": "muse_environment_describe",
      "description": "Describe OS, home folder, displays, permissions, computer-use capabilities, installed app names, and running app names (the frontmost is marked)."
    },
    "computer.session": {
      "category": "computer_use",
      "windows_port": "muse_computer_session",
      "description": "Start or end a background Computer-Use Agent (CUA) session with a human-visible task banner and immediate Stop button override (Node 0)."
    },
    "computer.observe": {
      "category": "computer_use",
      "windows_port": "muse_computer_observe",
      "description": "Observe the selected window with a fresh observation_id, numbered UIAutomation/Win32 controls (<id> <role> '<label>' value='<value>' [states]) at normalized 0..1000 coordinates, and delta tracking (elements_unchanged, newly_listed_elements)."
    },
    "computer.control": {
      "category": "computer_use",
      "windows_port": "muse_computer_control",
      "description": "Execute background or targeted window actions (list_windows, open_app, activate, click, click_element, focus, type, fill, scroll, reconcile) with d-separation action receipts (retryable, required_next, side_effect)."
    },
    "screen.snap": {
      "category": "computer_use",
      "windows_port": "muse_screen_snap",
      "description": "Capture the selected window or display and run Set-of-Mark (SoMAnnotator) numbered bounding-box overlays at normalized 0..1000 coordinates."
    },
    "files.list": {
      "category": "filesystem",
      "windows_port": "muse_files_list",
      "description": "List one folder with size/modified sorting and credential-path exclusions."
    },
    "files.search": {
      "category": "filesystem",
      "windows_port": "muse_files_search",
      "description": "Bounded fast file/folder search (caps at 100,000 entries, 1,000 matches, or 6s) excluding hidden/credential/Trash paths."
    },
    "files.read": {
      "category": "filesystem",
      "windows_port": "muse_files_read",
      "description": "Paginated UTF-8 line reader (and image metadata reader) rejecting credential files."
    },
    "files.write": {
      "category": "filesystem",
      "windows_port": "muse_files_write",
      "description": "Create or overwrite UTF-8 text files with credential-path protection."
    },
    "files.edit": {
      "category": "filesystem",
      "windows_port": "muse_files_edit",
      "description": "Surgical single-match verbatim text replacement in existing UTF-8 files."
    },
    "files.mkdir": {
      "category": "filesystem",
      "windows_port": "muse_files_mkdir",
      "description": "Create folder with optional parent creation."
    },
    "files.move": {
      "category": "filesystem",
      "windows_port": "muse_files_move",
      "description": "Move or rename a file/folder when destination does not exist."
    },
    "files.copy": {
      "category": "filesystem",
      "windows_port": "muse_files_copy",
      "description": "Byte-for-byte file/folder copy with size/item bounds and credential exclusions."
    },
    "files.trash": {
      "category": "filesystem",
      "windows_port": "muse_files_trash",
      "description": "Move files/folders recoverably to Trash (.muse_trash), returning trashed_path for instant undo (Sweetbrier Node 2 compliant)."
    }
  },
